    "consent.agree": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik geef toestemming"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I give my consent"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich willige ein"
          }
        }
      }
    },
    "consent.body": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitling slaat je geboortedatum, geslacht, lengte, gewicht, activiteitsniveau en doel op. Dat zijn gezondheidsgegevens. We gebruiken ze alleen om je dagdoel te berekenen en je voortgang bij te houden, en bewaren ze in je eigen account. Je kunt je toestemming altijd intrekken door je account te verwijderen; dan wissen we alles."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitling stores your date of birth, sex, height, weight, activity level and goal. This is health data. We only use it to calculate your daily target and track your progress, and keep it in your own account. You can withdraw your consent at any time by deleting your account; we then erase everything."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitling speichert dein Geburtsdatum, dein Geschlecht, deine Größe, dein Gewicht, dein Aktivitätsniveau und dein Ziel. Das sind Gesundheitsdaten. Wir nutzen sie nur, um dein Tagesziel zu berechnen und deinen Fortschritt festzuhalten, und speichern sie in deinem eigenen Konto. Du kannst deine Einwilligung jederzeit widerrufen, indem du dein Konto löschst; dann löschen wir alles."
          }
        }
      }
    },
    "consent.title": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw gegevens"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten"
          }
        }
      }
    },
    "creature.message.asleep.coach.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Even pauze gehad? Log één maaltijd en je bent weer bezig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Had a break? Log one meal and you are back at it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurze Pause gehabt? Erfasse eine Mahlzeit und du bist wieder dabei."
          }
        }
      }
    },
    "creature.message.asleep.coach.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnieuw beginnen is makkelijk: log je volgende maaltijd."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting again is easy: log your next meal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neu anfangen ist leicht: Erfasse deine nächste Mahlzeit."
          }
        }
      }
    },
    "creature.message.asleep.coach.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik slaap. Eén log en we gaan verder waar we waren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm asleep. One log and we carry on where we were."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich schlafe. Ein Eintrag und wir machen weiter, wo wir waren."
          }
        }
      }
    },
    "creature.message.asleep.funny.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik droom van je ontbijt. Maak je het waar?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I dream of your breakfast. Will you make it real?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich träume von deinem Frühstück. Machst du es wahr?"
          }
        }
      }
    },
    "creature.message.asleep.funny.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik hou een winterslaap. Een log is mijn wekker."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm hibernating. A log is my alarm clock."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich halte Winterschlaf. Ein Eintrag ist mein Wecker."
          }
        }
      }
    },
    "creature.message.asleep.funny.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snurk. Psst, één log en ik doe weer mee."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snore. Psst, one log and I'm back in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnarch. Psst, ein Eintrag und ich bin wieder dabei."
          }
        }
      }
    },
    "creature.message.asleep.sweet.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zzz… Ik word wakker zodra je iets logt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zzz… I'll wake up as soon as you log something."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zzz… Ich wache auf, sobald du etwas erfasst."
          }
        }
      }
    },
    "creature.message.asleep.sweet.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb je gemist. Eén maaltijd en ik ben er weer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've missed you. One meal and I'm back."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe dich vermisst. Eine Mahlzeit und ich bin wieder da."
          }
        }
      }
    },
    "creature.message.asleep.sweet.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik slaap, maar ik wacht op je. Geen haast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm asleep, but I'm waiting for you. No rush."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich schlafe, aber ich warte auf dich. Keine Eile."
          }
        }
      }
    },
    "creature.message.fit.coach.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mooi op koers. Houd dit ritme vast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicely on track. Keep this rhythm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schön auf Kurs. Halte diesen Rhythmus."
          }
        }
      }
    },
    "creature.message.fit.coach.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zit binnen je doel. Zo bouw je een gewoonte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're within your target. That's how a habit is built."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du liegst im Ziel. So entsteht eine Gewohnheit."
          }
        }
      }
    },
    "creature.message.fit.coach.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sterke week. Vandaag gewoon weer loggen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strong week. Just log again today."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starke Woche. Heute einfach wieder erfassen."
          }
        }
      }
    },
    "creature.message.fit.funny.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ben zo fit dat ik mijn eigen schaduw inhaal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm so fit I'm overtaking my own shadow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin so fit, dass ich meinen eigenen Schatten überhole."
          }
        }
      }
    },
    "creature.message.fit.funny.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groot nieuws: je partner straalt. Meer om tien uur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breaking news: your partner is glowing. More at ten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eilmeldung: Dein Partner strahlt. Mehr um zehn."
          }
        }
      }
    },
    "creature.message.fit.funny.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dit zo doorgaat, krijg ik nog spierballen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this keeps up, I might grow muscles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das so weitergeht, kriege ich noch Muskeln."
          }
        }
      }
    },
    "creature.message.fit.sweet.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik voel me zo fijn. Dank je wel voor deze week!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I feel so good. Thank you for this week!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich fühle mich so gut. Danke für diese Woche!"
          }
        }
      }
    },
    "creature.message.fit.sweet.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We doen het samen echt goed, weet je dat?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We're doing really well together, you know?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir machen das zusammen richtig gut, weißt du?"
          }
        }
      }
    },
    "creature.message.fit.sweet.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ben blij en sterk. Zullen we zo doorgaan?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm happy and strong. Shall we keep going like this?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin glücklich und stark. Machen wir so weiter?"
          }
        }
      }
    },
    "creature.message.hungry.coach.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd voor eiwit. Wat eet je?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time for protein. What are you eating?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit für Eiweiß. Was isst du?"
          }
        }
      }
    },
    "creature.message.hungry.coach.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinds gisteren niets gelogd. Begin met je volgende maaltijd."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing logged since yesterday. Start with your next meal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit gestern nichts erfasst. Fang mit deiner nächsten Mahlzeit an."
          }
        }
      }
    },
    "creature.message.hungry.coach.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log wat je eet, dan weet je waar je staat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log what you eat, then you know where you stand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse, was du isst, dann weißt du, wo du stehst."
          }
        }
      }
    },
    "creature.message.hungry.funny.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijn maag knort harder dan jouw wekker"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My stomach growls louder than your alarm clock"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mein Magen knurrt lauter als dein Wecker"
          }
        }
      }
    },
    "creature.message.hungry.funny.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb zo’n honger dat ik de barcode wil opeten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm so hungry I could eat the barcode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe solchen Hunger, dass ich den Barcode essen könnte."
          }
        }
      }
    },
    "creature.message.hungry.funny.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rommel, rommel. Dat was mijn buik. Wat eten we?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rumble, rumble. That was my tummy. What are we eating?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grummel, grummel. Das war mein Bauch. Was essen wir?"
          }
        }
      }
    },
    "creature.message.hungry.sweet.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb honger 🥺"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm hungry 🥺"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe Hunger 🥺"
          }
        }
      }
    },
    "creature.message.hungry.sweet.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijn buikje rommelt. Wat eten we?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My tummy's rumbling. What are we eating?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mein Bäuchlein grummelt. Was essen wir?"
          }
        }
      }
    },
    "creature.message.hungry.sweet.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat heb je vandaag al gegeten? Ik ben zo benieuwd."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What have you eaten today? I'm so curious."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was hast du heute schon gegessen? Ich bin so gespannt."
          }
        }
      }
    },
    "creature.message.normal.coach.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log je volgende maaltijd, dan blijf je bij."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log your next meal and stay up to date."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse deine nächste Mahlzeit, dann bleibst du auf dem Laufenden."
          }
        }
      }
    },
    "creature.message.normal.coach.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke log telt. Wat staat er op het menu?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every log counts. What's on the menu?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Eintrag zählt. Was steht auf dem Speiseplan?"
          }
        }
      }
    },
    "creature.message.normal.coach.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Even bijwerken: wat heb je gegeten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick update: what did you eat?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz nachtragen: Was hast du gegessen?"
          }
        }
      }
    },
    "creature.message.normal.funny.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik verveel me een beetje. Vertel me over je bord!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm a little bored. Tell me about your plate!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mir ist ein bisschen langweilig. Erzähl mir von deinem Teller!"
          }
        }
      }
    },
    "creature.message.normal.funny.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijn agenda is leeg. Die van je maaltijden ook?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My calendar is empty. Is your meal log too?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mein Kalender ist leer. Dein Essensprotokoll auch?"
          }
        }
      }
    },
    "creature.message.normal.funny.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb je lunch nog niet gezien. Was hij onzichtbaar?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I haven't seen your lunch yet. Was it invisible?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe dein Mittagessen noch nicht gesehen. War es unsichtbar?"
          }
        }
      }
    },
    "creature.message.normal.sweet.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoi! Ik ben benieuwd wat je vandaag eet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi! I'm curious what you'll eat today."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo! Ich bin gespannt, was du heute isst."
          }
        }
      }
    },
    "creature.message.normal.sweet.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijn dat je er bent. Vertel je me wat je eet?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glad you're here. Will you tell me what you eat?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schön, dass du da bist. Erzählst du mir, was du isst?"
          }
        }
      }
    },
    "creature.message.normal.sweet.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik zit hier lekker. Even je maaltijd loggen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm comfy here. Log your meal for a moment?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich sitze hier gemütlich. Kurz deine Mahlzeit erfassen?"
          }
        }
      }
    },
    "creature.message.tooLittle.coach.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zit ruim onder je doel. Genoeg eten telt ook."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're well below your target. Eating enough counts too."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du liegst deutlich unter deinem Ziel. Genug essen zählt auch."
          }
        }
      }
    },
    "creature.message.tooLittle.coach.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te weinig eten werkt tegen je. Voeg een maaltijd of snack toe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eating too little works against you. Add a meal or a snack."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig essen arbeitet gegen dich. Füge eine Mahlzeit oder einen Snack hinzu."
          }
        }
      }
    },
    "creature.message.tooLittle.coach.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brandstof eerst. Kies iets met eiwit en koolhydraten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuel first. Pick something with protein and carbohydrates."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erst der Treibstoff. Wähle etwas mit Eiweiß und Kohlenhydraten."
          }
        }
      }
    },
    "creature.message.tooLittle.funny.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijn batterij is bijna leeg. Een snack doet wonderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My battery is nearly flat. A snack works wonders."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mein Akku ist fast leer. Ein Snack wirkt Wunder."
          }
        }
      }
    },
    "creature.message.tooLittle.funny.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ben zo moe dat ik geeuw in mijn slaap. Tijd om te eten!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm so tired I yawn in my sleep. Time to eat!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin so müde, dass ich im Schlaf gähne. Zeit zu essen!"
          }
        }
      }
    },
    "creature.message.tooLittle.funny.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik zie sterretjes, en niet de leuke. Wat eet je?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I see stars, and not the fun kind. What are you eating?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich sehe Sterne, und nicht die schönen. Was isst du?"
          }
        }
      }
    },
    "creature.message.tooLittle.sweet.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ben een beetje moe. Eet je vandaag wel genoeg?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm a little tired. Are you eating enough today?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin ein bisschen müde. Isst du heute genug?"
          }
        }
      }
    },
    "creature.message.tooLittle.sweet.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb energie van je nodig. Een stevige maaltijd?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I need some energy from you. A hearty meal?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich brauche Energie von dir. Eine kräftige Mahlzeit?"
          }
        }
      }
    },
    "creature.message.tooLittle.sweet.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg goed voor jezelf, dan kan ik dat ook."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take good care of yourself, then I can too."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass gut auf dich auf, dann kann ich das auch."
          }
        }
      }
    },
    "creature.message.tooMuch.coach.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze week iets boven je doel. Kies vandaag groente en eiwit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bit above your target this week. Go for vegetables and protein today."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Woche etwas über dem Ziel. Wähle heute Gemüse und Eiweiß."
          }
        }
      }
    },
    "creature.message.tooMuch.coach.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine stap: een kleinere portie en een glas water erbij."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small step: a smaller portion and a glass of water with it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleiner Schritt: eine kleinere Portion und ein Glas Wasser dazu."
          }
        }
      }
    },
    "creature.message.tooMuch.coach.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijsturen kan altijd. Plan je volgende maaltijd vooruit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can always adjust. Plan your next meal ahead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachsteuern geht immer. Plane deine nächste Mahlzeit im Voraus."
          }
        }
      }
    },
    "creature.message.tooMuch.funny.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik rol meer dan ik loop. Een frisse salade misschien?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I roll more than I walk. A fresh salad, maybe?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich rolle mehr, als ich laufe. Vielleicht ein frischer Salat?"
          }
        }
      }
    },
    "creature.message.tooMuch.funny.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijn buikje wil een rustdag. Doe je mee?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My tummy wants a rest day. Are you in?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mein Bäuchlein will einen Ruhetag. Machst du mit?"
          }
        }
      }
    },
    "creature.message.tooMuch.funny.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb lang genoeg stilgezeten. Zullen we bewegen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've sat still long enough. Shall we move?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe lange genug stillgesessen. Wollen wir uns bewegen?"
          }
        }
      }
    },
    "creature.message.tooMuch.sweet.1": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik voel me wat zwaar. Zullen we het vandaag rustig aan doen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I feel a bit heavy. Shall we take it easy today?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich fühle mich etwas schwer. Wollen wir es heute ruhig angehen?"
          }
        }
      }
    },
    "creature.message.tooMuch.sweet.2": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een lichte maaltijd zou ik nu fijn vinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A light meal would be lovely right now."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine leichte Mahlzeit fände ich jetzt schön."
          }
        }
      }
    },
    "creature.message.tooMuch.sweet.3": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen zorgen, elke dag is een nieuwe kans. Ik ben bij je."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No worries, every day is a new chance. I'm with you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Sorge, jeder Tag ist eine neue Chance. Ich bin bei dir."
          }
        }
      }
    },
