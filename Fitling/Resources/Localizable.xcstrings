    "partner.today.footer": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De XP telt mee zodra de dag voorbij is. Dicht bij je doel betekent hoogstens een tiende eronder of erboven. Minder eten levert nooit XP op."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The XP counts once the day is over. Close to your target means at most a tenth below or above it. Eating less never earns XP."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die XP zählen, sobald der Tag vorbei ist. Nah am Ziel heißt höchstens ein Zehntel darunter oder darüber. Weniger essen bringt nie XP."
          }
        }
      }
    },
