          "stringUnit": {
            "state": "translated",
            "value": "Protein"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eiweiß"
          }
        }
      }
    },
    "targets.warning.belowFloor": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit doel ligt onder wat je lichaam in rust al verbruikt, met een kleine marge. Zo lang volhouden is zwaar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This target is below what your body burns at rest, plus a small margin. That is hard to keep up for long."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Ziel liegt unter dem, was dein Körper in Ruhe verbraucht, plus einem kleinen Puffer. Das hält man nicht lange durch."
          }
        }
      }
    },
    "targets.warning.largeDeficit": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit doel ligt meer dan een kwart onder je verbruik. Afvallen gaat dan snel, maar je houdt het minder lang vol."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This target is more than a quarter below what you burn. You would lose weight fast, but it is harder to keep up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Ziel liegt mehr als ein Viertel unter deinem Verbrauch. Du nimmst schnell ab, hältst es aber schwerer durch."
          }
        }
      }
    },
    "targets.warning.low": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit doel is lager dan wat meestal als veilig geldt. Twijfel je, overleg dan met een arts of diëtist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This target is lower than what’s usually considered safe. If in doubt, talk to a doctor or dietitian."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Ziel liegt unter dem, was meist als sicher gilt. Sprich im Zweifel mit einer Ärztin, einem Arzt oder einer Ernährungsberatung."
          }
        }
      }
    },
