    "training.advice.easier": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee keer onder het bereik: kies een lichtere variant."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under the range twice: pick an easier variation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweimal unter dem Bereich: Wähle eine leichtere Variante."
          }
        }
      }
    },
    "training.advice.harder": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bovenkant van het bereik gehaald: voeg gewicht toe of kies een zwaardere variant."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top of the range reached: add weight or pick a harder variation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberes Ende erreicht: Füge Gewicht hinzu oder wähle eine schwerere Variante."
          }
        }
      }
    },
    "training.advice.increase %@": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle sets gehaald: ga naar %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every set done: move up to %@."
          }
