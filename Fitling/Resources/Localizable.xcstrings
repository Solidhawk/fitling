{
  "sourceLanguage": "nl",
  "strings": {
    "auth.email.field": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mailadres"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email address"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail-Adresse"
          }
        }
      }
    },
    "auth.error.apple": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen met Apple lukte niet. Probeer het opnieuw."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in with Apple didn’t work. Please try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit Apple hat nicht geklappt. Versuch es noch einmal."
          }
        }
      }
    },
    "auth.error.emailNotConfirmed": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig eerst je e-mailadres."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm your email address first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige zuerst deine E-Mail-Adresse."
          }
        }
      }
    },
    "auth.error.invalidCredentials": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mailadres of wachtwoord klopt niet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email or password is incorrect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail-Adresse oder Passwort stimmt nicht."
          }
        }
      }
    },
    "auth.error.rateLimited": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel pogingen. Probeer het later opnieuw."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Try again later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Versuch es später noch einmal."
          }
        }
      }
    },
    "auth.error.weakPassword": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een sterker wachtwoord: minimaal 8 tekens en niet makkelijk te raden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a stronger password: at least 8 characters and hard to guess."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein stärkeres Passwort: mindestens 8 Zeichen und schwer zu erraten."
          }
        }
      }
    },
