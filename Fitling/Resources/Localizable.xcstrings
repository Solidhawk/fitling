            "value": "Neues Passwort"
          }
        }
      }
    },
    "auth.reset.linkInvalid": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze link werkt alleen op het toestel waar je hem hebt aangevraagd. Vraag een nieuwe aan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link only works on the device where you requested it. Request a new one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link funktioniert nur auf dem Gerät, auf dem du ihn angefordert hast. Fordere einen neuen an."
          }
        }
      }
    },
    "auth.reset.rateLimited": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel pogingen. Probeer het over een uur opnieuw."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Try again in an hour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Versuch es in einer Stunde noch einmal."
          }
        }
      }
    },
    "auth.reset.sent": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als er een account met dit adres is, krijg je een mail. Log je in met Apple of Google? Gebruik dan die knop."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If there’s an account with this address, you’ll get an email. Do you sign in with Apple or Google? Use that option instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn es ein Konto mit dieser Adresse gibt, bekommst du eine E-Mail. Meldest du dich mit Apple oder Google an? Dann nutze diese Anmeldung."
          }
        }
      }
    },
    "auth.reset.submit": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachtwoord opslaan"
          }
        },
