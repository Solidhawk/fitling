{
  "sourceLanguage": "nl",
  "strings": {
    "account.delete": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Account verwijderen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto löschen"
          }
        }
      }
    },
    "account.delete.apple": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig met Apple om je account te verwijderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm with Apple to delete your account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige mit Apple, um dein Konto zu löschen."
          }
        }
      }
    },
    "account.delete.body": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert je account en al je gegevens, op deze iPhone en op onze server. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes your account and all your data, on this iPhone and on our server. This can’t be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden dein Konto und alle deine Daten gelöscht, auf diesem iPhone und auf unserem Server. Das lässt sich nicht rückgängig machen."
          }
        }
      }
    },
    "account.delete.confirm": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Account definitief verwijderen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account permanently"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto endgültig löschen"
          }
        }
      }
    },
    "account.signOut": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitloggen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abmelden"
          }
        }
      }
    },
    "account.title": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto"
          }
        }
      }
    },
    "account.unsynced.body": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige wijzigingen staan nog alleen op deze iPhone. Als je nu uitlogt, gaan ze verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some changes are only on this iPhone. If you sign out now, they’ll be lost."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Änderungen sind nur auf diesem iPhone. Wenn du dich jetzt abmeldest, gehen sie verloren."
          }
        }
      }
    },
    "account.unsynced.force": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toch uitloggen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out anyway"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trotzdem abmelden"
          }
        }
      }
    },
    "account.unsynced.title": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet alles is opgeslagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not everything is saved"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht alles ist gespeichert"
          }
        }
      }
    },
