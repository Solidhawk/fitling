    "training.advice.keepGoing %@": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf op %@ en werk naar de bovenkant van het bereik."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay at %@ and work towards the top of the range."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
