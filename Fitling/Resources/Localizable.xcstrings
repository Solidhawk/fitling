            "state": "translated",
            "value": "De volgende stap is groot: haal eerst %1$lld herhalingen per set op %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next step is a big one: first reach %1$lld reps per set at %2$@."
