    "training.compose.footer": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerst de zware basisoefeningen, dan de kleinere. Oefeningen die je het langst niet hebt gedaan gaan voor, zodat je trainingen afwisselen. De training komt in je schema \"Samengestelde training\"."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The heavy compound exercises first, then the smaller ones. Exercises you have not done for the longest come first, so your workouts vary. The workout goes into your programme \"Composed workout\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst die schweren Grundübungen, dann die kleineren. Übungen, die du am längsten nicht gemacht hast, kommen zuerst, damit deine Trainings abwechseln. Das Training kommt in dein Programm „Zusammengestelltes Training\"."
          }
        }
      }
    },
