    "auth.reset.sent": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als er een account met dit adres is, krijg je een mail. Log je in met Apple of Google? Gebruik dan die knop."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If there’s an account with this address, you’ll get an email. Do you sign in with Apple or Google? Use that option instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn es ein Konto mit dieser Adresse gibt, bekommst du eine E-Mail. Meldest du dich mit Apple oder Google an? Dann nutze diese Anmeldung."
          }
        }
      }
    },
