    "auth.verify.body %@": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben een link gestuurd naar %@. Open hem op deze iPhone om verder te gaan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We sent a link to %@. Open it on this iPhone to continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben einen Link an %@ geschickt. Öffne ihn auf diesem iPhone, um weiterzumachen."
