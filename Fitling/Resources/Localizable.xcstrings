    "auth.error.weakPassword": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een sterker wachtwoord: minimaal 8 tekens en niet makkelijk te raden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a stronger password: at least 8 characters and hard to guess."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein stärkeres Passwort: mindestens 8 Zeichen und schwer zu erraten."
          }
