    "consent.agree": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik geef toestemming"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I give my consent"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
