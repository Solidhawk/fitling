        }
      }
    },
    "training.advice.easeBack %@": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Even weggeweest: begin rustig op %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Been away for a while: ease back in at %@."
